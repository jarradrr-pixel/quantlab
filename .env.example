# Copy to .env and fill in. Never commit .env. No real credentials belong in
# this file, in the repository, or in a chat window.

QUANTLAB_ENVIRONMENT=local
QUANTLAB_DEBUG=false
QUANTLAB_LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QUANTLAB_SECRET_KEY=replace-me-with-a-generated-value

# PostgreSQL (preferred). The SQLite fallback below is for local development.
QUANTLAB_DATABASE_URL=postgresql+psycopg://quantlab:quantlab@localhost:5432/quantlab
# QUANTLAB_DATABASE_URL=sqlite+pysqlite:///./quantlab.db

# Set false only when serving over plain HTTP on localhost.
QUANTLAB_SESSION_COOKIE_SECURE=true

# First operator account, created at start-up if it does not exist.
QUANTLAB_BOOTSTRAP_OPERATOR_EMAIL=operator@example.com
QUANTLAB_BOOTSTRAP_OPERATOR_PASSWORD=change-this-long-password

# Safety. The system boots halted; an operator releases the kill switch in the UI.
QUANTLAB_KILL_SWITCH_ENGAGED_ON_BOOT=true
QUANTLAB_REQUIRE_HUMAN_APPROVAL=true
QUANTLAB_TRADING_MODE=paper

# Strategy guard rails (MVP defaults).
QUANTLAB_ALLOWED_SYMBOLS=["SPY"]
QUANTLAB_ALLOWED_TIMEFRAMES=["1Day"]
QUANTLAB_MAX_POSITION_PERCENTAGE=2.0
QUANTLAB_MAX_TOTAL_EXPOSURE_PERCENTAGE=10.0
QUANTLAB_MAX_DAILY_LOSS_PERCENTAGE=1.0
QUANTLAB_MAX_ORDERS_PER_DAY=2

# --- Phase 3: Alpaca paper broker (optional) ----------------------------
# Leave both unset to run without a broker connection; the /broker page
# reports "not configured" and no Alpaca call is made. If set, both must be
# set together. QUANTLAB_ALPACA_PAPER_BASE_URL must point at Alpaca's paper
# endpoint -- the application refuses to start otherwise.
# QUANTLAB_ALPACA_API_KEY=
# QUANTLAB_ALPACA_API_SECRET=
QUANTLAB_ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
